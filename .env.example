# OSIRIS origin (live or self-hosted)
OSIRIS_BASE_URL=https://osirisai.live

# Local Ollama (compose overrides to http://ollama:11434 inside the stack)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b

# Worker schedule (minimum 60 recommended; feeds TTL ~45–60s)
POLL_INTERVAL_SEC=120
WORKER_MODE=schedule

# FastAPI host port
SANDBOX_API_PORT=8787

# Data directory (mounted as /data in containers)
DATA_DIR=./data

# Optional: comma-separated core feed ids override (see feeds.py CORE_FEED_IDS)
# CORE_FEEDS=earthquakes,fires,conflicts,news,cyber-threats,maritime,flights,markets,space-weather

# Max items kept per feed after consolidation
TOP_N=12