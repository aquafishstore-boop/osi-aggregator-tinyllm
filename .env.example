# OSIRIS origin (live or self-hosted)
OSIRIS_BASE_URL=https://osirisai.live

# Local Ollama (compose overrides to http://ollama:11434 inside the stack)
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=qwen2.5:1.5b

# Worker schedule (minimum 60 recommended; feeds TTL ~45–60s)
POLL_INTERVAL_SEC=120
WORKER_MODE=schedule

# FastAPI host port
SANDBOX_API_PORT=8787

# Data directory (mounted as /data in containers)
DATA_DIR=./data

# Optional: comma-separated core feed ids override (see feeds.py CORE_FEED_IDS)
# CORE_FEEDS=earthquakes,fires,conflicts,news,cyber-threats,maritime,flights,markets,space-weather

# Max items kept per feed after consolidation
TOP_N=12

# ---------------------------------------------------------------------------
# Storage backend for data (snapshots), analysis (consolidated) and agentic
# outputs (broad/fine briefings).
#
# Policy: `local` needs no auth. Any non-local backend (`s3`, `http`) MUST be
# authenticated with a PAT / API token / cloud credentials, or the run fails
# closed at startup. Encryption (optional) requires a Fernet key.
# ---------------------------------------------------------------------------
STORAGE_BACKEND=local            # local | s3 | http

# Optional client-side encryption at rest (wraps any backend).
# Generate a key: python -c "from cryptography.fernet import Fernet;print(Fernet.generate_key().decode())"
STORAGE_ENCRYPTION=false
# STORAGE_ENCRYPTION_KEY=

# --- http backend (token-authenticated REST object store) ---
# STORAGE_HTTP_URL=https://store.example.com/osiris
# STORAGE_HTTP_TOKEN=            # PAT / API token (required for STORAGE_BACKEND=http)
# STORAGE_HTTP_VERIFY_TLS=true

# --- s3 backend (AWS S3 / Cloudflare R2 / MinIO; pip install 'osi-sandbox[s3]') ---
# STORAGE_S3_BUCKET=osiris-sandbox
# STORAGE_S3_PREFIX=runs
# STORAGE_S3_ENDPOINT_URL=       # set for R2/MinIO; omit for AWS
# STORAGE_S3_REGION=us-east-1
# STORAGE_S3_ACCESS_KEY_ID=      # API credentials (required for STORAGE_BACKEND=s3)
# STORAGE_S3_SECRET_ACCESS_KEY=
# STORAGE_S3_SESSION_TOKEN=