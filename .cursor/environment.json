{
  "name": "osi-aggregator-tinyllm",
  "install": "bash .cursor/install.sh",
  "start": "bash .cursor/start.sh",
  "terminals": [
    {
      "name": "api",
      "command": ". .venv/bin/activate && OLLAMA_BASE_URL=http://127.0.0.1:11434 PROMPTS_DIR=$PWD/prompts DATA_DIR=$PWD/data python -m osi_sandbox.api",
      "description": "FastAPI service on :8787. Endpoints: /health, /status, /feeds, POST /run, /reports/latest."
    },
    {
      "name": "worker",
      "command": ". .venv/bin/activate && OLLAMA_BASE_URL=http://127.0.0.1:11434 PROMPTS_DIR=$PWD/prompts DATA_DIR=$PWD/data python -m osi_sandbox.worker",
      "description": "Scheduled passive-feed ingest + broad/fine tiny-LLM analysis loop (POLL_INTERVAL_SEC, default 120s)."
    }
  ],
  "ports": [
    {
      "name": "api",
      "port": 8787
    }
  ]
}
